#include <bits/stdc++.h>
using namespace std;

int anagram(string s) {
    int n = s.size();
    
    // If odd length, anagram not possible
    if (n % 2 == 1) return -1;
    
    int half = n / 2;
    int cntL[26] = {0};
    int cntR[26] = {0};
    
    // Count left half
    for (int i = 0; i < half; i++) {
        cntL[s[i] - 'a']++;
    }
    
    // Count right half
    for (int i = half; i < n; i++) {
        cntR[s[i] - 'a']++;
    }
    
    // Compute deletions needed
    int deletions = 0;
    for (int i = 0; i < 26; i++) {
        if (cntL[i] > cntR[i]) {
            deletions += (cntL[i] - cntR[i]);
        }
    }
    
    return deletions;
}

int main() {
    int q;
    cin >> q;
    while (q--) {
        string s;
        cin >> s;
        cout << anagram(s) << endl;
    }
    return 0;
}
